rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /submissions/{assignmentId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if true;
    }
    match /sessions/{sessionId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if true;
    }
    match /{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
